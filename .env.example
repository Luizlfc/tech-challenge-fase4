# Copie para .env (que está no .gitignore) e preencha. NUNCA faça commit do .env.
# Sem MLFLOW_TRACKING_URI, o projeto usa MLflow local em ./mlruns (100% offline).

AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-mlet-fase4
AZURE_ML_WORKSPACE=mlw-mlet-fase4

# Obtenha com: python -m src.tracking --azure   (ou: az ml workspace show ... --query mlflow_tracking_uri -o tsv)
# Formato: azureml://<regiao>.api.azureml.ms/mlflow/v1.0/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.MachineLearningServices/workspaces/<ws>
MLFLOW_TRACKING_URI=

# Salt da pseudonimização (em produção viria de um cofre de segredos)
PSEUDO_SALT=
